rules_version = '2';
// users/{uid}: each player's saved profile, private to its owner (written by cloud.js).
// ranking-YYYY-MM/{uid}: the world ranking of each monthly season. Anyone can read it; only
// the game server writes it (with the admin key, which skips these rules), so nobody can
// raise their own trophies. ranking/{uid}: the ranking from before seasons, read-only now.
// Players can delete their own rows. Paste these rules in Firebase console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt', 'name', 'level'])
        && request.resource.data.profile is string
        && request.resource.data.profile.size() < 20000;
    }
    match /ranking/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{season}/{uid} {
      allow read: if season.matches('ranking-[0-9]{4}-[0-9]{2}');
      allow delete: if season.matches('ranking-[0-9]{4}-[0-9]{2}') && request.auth != null && request.auth.uid == uid;
    }
  }
}
